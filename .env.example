# Next.js App Router Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
# Production EC2 (Nginx path): http://<EC2_PUBLIC_IP>/web/api/v1
# Web OAuth client ID (Google Cloud Console → Web application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple Services ID (Sign in with Apple → Identifiers → Services IDs)
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Must match a Return URL configured on the Apple Services ID (defaults to window.location.origin)
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Legacy Vite compatibility aliases
VITE_API_URL=http://localhost:3002/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
